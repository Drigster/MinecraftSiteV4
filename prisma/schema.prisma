datasource db {
  provider = "sqlite"
  url      = ""
}

generator kysely {
  provider = "prisma-kysely"

  output   = "../src/lib/server/db"
  fileName = "schema.d.ts"
}

model User {
  /// @kyselyType(`u_${string}`)
  id       String @id
  uuid     String @unique
  username String @unique
  email    String @unique
  password String

  /// @kyselyType(boolean)
  verified   Boolean   @default(false)
  regDate    DateTime
  /// @kyselyType('PLAYER' | 'MODERATOR' | 'ADMIN')
  role       String    @default("PLAYER")
  lastPlayed DateTime?

  sessions           Session[]
  changeEmailRequest ChangeEmailRequest?
}

model ChangeEmailRequest {
  /// @kyselyType(`cef_${string}`)
  id String @id

  new_email  String
  code_hash  String
  expires_at Int

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@unique([user_id])
}

model Session {
  id         String @id
  expires_at Int

  server_id String?

  device     String?
  location   String?
  ip         String?
  /// @kyselyType("SITE" | "LAUNCHER")
  type       String
  last_login DateTime

  user    User   @relation(fields: [user_id], references: [id])
  /// @kyselyType(`u_${string}`)
  user_id String
}
