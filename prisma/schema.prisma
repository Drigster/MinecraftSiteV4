datasource db {
  provider = "sqlite"
  url      = ""
}

generator kysely {
  provider = "prisma-kysely"

  output   = "../src/lib/server/db"
  fileName = "schema.d.ts"
}

model User {
  /// @kyselyType(`u_${string}`)
  id       String @id
  uuid     String @unique
  username String @unique
  email    String @unique
  password String

  /// @kyselyType(boolean)
  verified   Boolean   @default(false)
  regDate    DateTime
  /// @kyselyType('PLAYER' | 'MODERATOR' | 'ADMIN')
  role       String    @default("PLAYER")
  lastPlayed DateTime?

  banned              Boolean @default(false)
  internal_ban_reason String?

  skin_digest  String?
  /// @kyselyType(boolean)
  skin_is_slim Boolean @default(false)
  cape_digest  String?

  sessions             Session[]
  hardwares            Hardware[]
  change_email_request ChangeEmailRequest?
}

model ChangeEmailRequest {
  /// @kyselyType(`cef_${string}`)
  id String @id

  new_email  String
  code_hash  String
  expires_at Int

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@unique([user_id])
}

model Hardware {
  /// @kyselyType(`h_${string}`)
  id         String @id
  public_key String

  hw_disk_id              String
  baseboard_serial_number String
  display_ids             String
  bitness                 Int
  total_memory            Int
  logical_processors      Int
  physical_processors     Int
  processor_max_freq      Int
  /// @kyselyType(boolean)
  battery                 Boolean
  oem_id                  String
  /// @kyselyType(boolean)

  banned              Boolean @default(false)
  internal_ban_reason String?

  users User[]
}

model Session {
  id         String @id
  expires_at Int

  refresh_token           String?
  access_token            String?
  access_token_expires_at Int?
  server_id               String?

  device     String?
  location   String?
  ip         String?
  /// @kyselyType("SITE" | "LAUNCHER")
  type       String
  last_login DateTime

  user    User   @relation(fields: [user_id], references: [id])
  /// @kyselyType(`u_${string}`)
  user_id String
}
